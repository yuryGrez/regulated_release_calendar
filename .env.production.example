# ============================================================
# Production environment variables template
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ============================================================

# ── Database (Railway PostgreSQL plugin) ──────────────────
DATABASE_URL=postgresql://rrc_user:<password>@<railway-host>:5432/rrc_db

# ── Redis (Railway Redis plugin) ─────────────────────────
REDIS_URL=redis://:<password>@<railway-host>:6379

# ── AWS SQS (real queues — provisioned by provision-aws.sh) ──
SQS_QUEUE_URL_RELEASES=https://sqs.eu-west-2.amazonaws.com/<account>/rrc-prod-releases.fifo
SQS_QUEUE_URL_NOTIFICATIONS=https://sqs.eu-west-2.amazonaws.com/<account>/rrc-prod-notifications.fifo
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=<iam-access-key>
AWS_SECRET_ACCESS_KEY=<iam-secret-key>

# ── Auth0 ──────────────────────────────────────────────────
AUTH0_DOMAIN=rrc-prod.eu.auth0.com
AUTH0_AUDIENCE=https://api.rrc.dev
JWT_ALGORITHMS=RS256

# ── Service ports ──────────────────────────────────────────
GATEWAY_PORT=8080
RELEASE_SVC_PORT=8081
RISK_ENGINE_PORT=8082
CALENDAR_SVC_PORT=8083
AUDIT_SVC_PORT=8084
NOTIF_SVC_PORT=8085

# ── Internal service URLs (used by risk-engine → audit-svc) ──
AUDIT_SVC_URL=http://audit-svc:8084

# ── Jira Integration ───────────────────────────────────────
JIRA_CLIENT_ID=<jira-oauth2-client-id>
JIRA_CLIENT_SECRET=<jira-oauth2-client-secret>
JIRA_WEBHOOK_SECRET=<random-32-byte-hex-secret>

# ── Notifications ──────────────────────────────────────────
SENDGRID_API_KEY=SG.<your-key>
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<your-webhook>

# ── Storage ────────────────────────────────────────────────
S3_AUDIT_BUCKET=rrc-prod-audit-worm
# No S3_ENDPOINT in production — uses real AWS endpoint

# ── Scraper ────────────────────────────────────────────────
SCRAPER_CRON=0 9 * * 1

# ── App ────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Frontend (build-time Vite vars) ───────────────────────
VITE_API_URL=https://api.rrc.dev
VITE_CALENDAR_URL=https://api.rrc.dev
VITE_AUDIT_URL=https://api.rrc.dev
VITE_AUTH0_DOMAIN=rrc-prod.eu.auth0.com
VITE_AUTH0_CLIENT_ID=<spa-client-id-from-auth0>
VITE_AUTH0_AUDIENCE=https://api.rrc.dev
