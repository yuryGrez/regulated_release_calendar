# Database
DATABASE_URL=postgresql://rrc_user:password@localhost:5432/rrc_db

# Redis
REDIS_URL=redis://localhost:6379

# Queue (use localstack or real SQS)
SQS_QUEUE_URL_RELEASES=http://localhost:4566/000000000000/rrc-releases.fifo
SQS_QUEUE_URL_NOTIFICATIONS=http://localhost:4566/000000000000/rrc-notifications.fifo
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Auth
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.rrc.dev
JWT_ALGORITHMS=RS256

# Services (internal)
RELEASE_SVC_PORT=8081
RISK_ENGINE_PORT=8082
CALENDAR_SVC_PORT=8083
AUDIT_SVC_PORT=8084
NOTIF_SVC_PORT=8085
AUDIT_SVC_URL=http://audit-svc:8084

# Jira Integration
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=

# Notifications
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# Storage
S3_AUDIT_BUCKET=rrc-audit-worm
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Scraper
SCRAPER_CRON=0 9 * * 1

# App
NODE_ENV=development
LOG_LEVEL=debug

# Frontend (Vite — must be prefixed VITE_)
VITE_API_URL=http://localhost:8081
VITE_CALENDAR_URL=http://localhost:8083
VITE_AUDIT_URL=http://localhost:8084
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.rrc.dev
